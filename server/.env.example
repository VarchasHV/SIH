# Copy to server/.env  (server/.env is gitignored — never commit real keys)

# gemini (default) | openai | mock
VLM_MODE=gemini

# --- gemini ---
GEMINI_API_KEY=API KEY
VLM_MODEL=gemini-3.6-flash      # gemini-2.5-flash is blocked for new keys; 3.6-flash works
                                # (2.5-pro / gemini-3.5-flash also fine if your key allows)

# --- openai-compatible VLM (VLM_MODE=openai) ---
# VLM_BASE_URL=https://openrouter.ai/api/v1
# VLM_API_KEY=sk-...
# VLM_MODEL=qwen/qwen-2.5-vl-7b-instruct
# offline: VLM_BASE_URL=http://localhost:11434/v1  VLM_MODEL=llama3.2-vision

# mock mode needs nothing and runs offline. It is opt-in only: if gemini/openai
# fails, /agent/step returns HTTP 503 and the agent stops — it never auto-swaps
# to mock and keeps acting on the page.

# ---------------------------------------------------------------------------
# Auth / entitlements / billing
# ---------------------------------------------------------------------------

# REQUIRED in production. If unset, a random secret is generated per process
# start (every restart invalidates all logged-in sessions) — fine for local
# dev, never acceptable for a real deployment.
# JWT_SECRET=change-me-to-a-long-random-value

# Defaults to a local sqlite file (server/connor.db). Point this at Postgres
# in production, e.g. postgresql+psycopg://user:pass@host:5432/connor
# DATABASE_URL=sqlite:///./connor.db

# mock (default, local dev/demo only — see server/billing/mock_provider.py) | stripe
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=dev-mock-webhook-secret
PUBLIC_APP_URL=http://localhost:8000

# --- stripe (BILLING_PROVIDER=stripe) — untested in this repo, no account configured ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_OPERATOR=price_...
# STRIPE_PRICE_COMMAND=price_...

# Optional overrides (see server/config.py for all defaults)
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# RATE_LIMIT_AUTH_PER_MIN=10
# RATE_LIMIT_STEP_PER_MIN=30
# RATE_LIMIT_WEBHOOK_PER_MIN=120

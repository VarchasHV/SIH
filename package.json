{
  "name": "privacy-lens-vision-agent",
  "version": "0.2.0",
  "private": true,
  "description": "SIH26171 - Privacy-preserving on-device vision agent for browser form-filling",
  "type": "module",
  "scripts": {
    "build": "node scripts/fetch-vendor.mjs",
    "setup": "npm run fetch:vendor && npm run server:install",
    "fetch:vendor": "node scripts/fetch-vendor.mjs",
    "fixtures": "node scripts/serve.mjs fixtures 4173",
    "serve": "node scripts/serve.mjs . 4173",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "eval": "node eval/run_eval.mjs",
    "bench": "node eval/bench/gen-corpus.mjs --seed 20260830 && node eval/bench/run.mjs",
    "bench:fast": ".venv/bin/python3 benchmarks/run_bench.py --n 2000",
    "bench:full": ".venv/bin/python3 benchmarks/run_bench.py --n 20000",
    "bench:live": ".venv/bin/python3 benchmarks/run_bench.py --n 5000 --live-vlm",
    "bench:json": ".venv/bin/python3 benchmarks/run_bench.py --n 5000 --json",
    "eval:agent": "node eval/agent-eval.mjs",
    "server": ".venv/bin/python -m uvicorn main:app --app-dir server --reload --reload-dir server --port 8000",
    "server:install": ".venv/bin/pip install -r server/requirements.txt"
  },
  "devDependencies": {}
}

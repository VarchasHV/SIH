# OS
.DS_Store

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/
server/.env

# Local dev database (dev-only auto-created; real deployments use DATABASE_URL + Alembic)
server/*.db
server/*.db-wal
server/*.db-shm

# Vendored ML libraries (fetch with: npm run fetch:vendor)
client/vendor/*
!client/vendor/README.md

# Eval output
eval/out/

# Large generated benchmark corpora (regenerate: npm run bench:large)
eval/bench/corpus-*.jsonl
eval/bench/corpus-*.manifest.json
eval/bench/corpus-*.results.*
eval/bench/corpus-*.redaction.*

# Misc
*.local
GEMINI.md
AGENTS.md
.env
